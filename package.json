{
  "name": "retramo",
  "displayName": "Retramo",
  "icon": "media/retramo-icon-256.png",
  "galleryBanner": {
    "color": "#0E1022",
    "theme": "dark"
  },
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "zoomieslabs",
  "license": "MIT",
  "author": {
    "name": "ZoomiesLabs",
    "email": "hello@zoomieslabs.dev",
    "url": "https://zoomieslabs.dev"
  },
  "homepage": "https://github.com/zoomieslabs/Retramo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zoomieslabs/Retramo"
  },
  "bugs": {
    "url": "https://github.com/zoomieslabs/Retramo/issues",
    "email": "hello@zoomieslabs.dev"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "adhd",
    "context",
    "focus",
    "session",
    "resume"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    }
  },
  "main": "./out/src/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "retramo.leave",
        "title": "%command.leave%",
        "category": "Retramo"
      },
      {
        "command": "retramo.return",
        "title": "%command.return%",
        "category": "Retramo"
      },
      {
        "command": "retramo.history",
        "title": "%command.history%",
        "category": "Retramo"
      },
      {
        "command": "retramo.openData",
        "title": "%command.openData%",
        "category": "Retramo"
      },
      {
        "command": "retramo.setApiKey",
        "title": "%command.setApiKey%",
        "category": "Retramo"
      }
    ],
    "keybindings": [
      {
        "command": "retramo.leave",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l"
      },
      {
        "command": "retramo.return",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "configuration": {
      "title": "Retramo",
      "properties": {
        "retramo.idleMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "description": "%config.idleMinutes%"
        },
        "retramo.away.exclude": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.away.exclude%"
        },
        "retramo.summary.provider": {
          "type": "string",
          "scope": "application",
          "enum": [
            "none",
            "openai",
            "anthropic",
            "ollama"
          ],
          "default": "none",
          "description": "%config.summary.provider%"
        },
        "retramo.summary.includeDiffs": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "markdownDescription": "%config.summary.includeDiffs%"
        },
        "retramo.summary.ollamaEndpoint": {
          "type": "string",
          "scope": "application",
          "default": "http://localhost:11434",
          "description": "%config.summary.ollamaEndpoint%"
        },
        "retramo.telemetry": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "%config.telemetry%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test",
    "test:unit": "vitest run",
    "test": "npm run compile && vscode-test",
    "check": "npm run compile && npm run lint && npm run test:unit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.93.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "mocha": "^11.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
